  "lessonNumber": 4,
  "title": "Articles: A, An, The",
  "estimatedMinutes": 8,
  "explanation": {
    "en": "Use a or an for a nonspecific singular countable noun. An comes before a vowel sound. The points to something specific.",
    "taglish": "Use a o an kapag nonspecific na isang bagay; an before vowel sound. Use the kapag specific na."
  },
  "examples": [
    "I received an email.",
    "The email contains the schedule."
  ],
  "exercises": [
